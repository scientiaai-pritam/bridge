# tdai-bridge local/dev environment variables.
# Copy to `.env` (or pass via `sam deploy --parameter-overrides`) and fill in.

# Same value the API tier's WebhookFn signs with (SSM WEBHOOK_SIGNING_SECRET
# on the api-tier stack). Mismatch = every webhook returns 401 bad_signature.
WEBHOOK_SIGNING_SECRET=

# Firebase service-account fields (Admin SDK).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=

# Service-account private key. Paste with literal "\n" character sequences
# (as exported by the Firebase console JSON). The bridge replaces them with
# real newlines at init — see src/firebase.js:
#   (process.env.FIREBASE_PRIVATE_KEY || '').replace(/\\n/g, '\n')
# Do NOT paste multi-line PEM here verbatim; keep it single-line with \n escapes.
FIREBASE_PRIVATE_KEY=

# Realtime Database URL, e.g. https://<project>.firebaseio.com
FIREBASE_DATABASE_URL=

# Web storage bucket (the web's STORAGE_BUCKET_NAME). Bridge uploads ingested
# API-tier outputs here under the legacy key pattern.
AWS_S3_BUCKET=

# AWS region of the web bucket (Lambda execution region). Defaults to ap-south-1.
AWS_REGION=

# Optional CloudFront domain serving the web bucket. Set with USE_CLOUDFRONT=true
# to have results carry a cloudfront_url instead of a presigned S3 URL.
CLOUDFRONT_DOMAIN=

# "true" enables CloudFront URL build (requires CLOUDFRONT_DOMAIN). Default off.
USE_CLOUDFRONT=
